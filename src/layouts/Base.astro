---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MouseTrail from '../components/MouseTrail.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} | Ewan Lefevre` : site.title;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="fr" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ewan Lefevre" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#06b6d4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Thème appliqué avant l'affichage (sombre par défaut, comme la référence) -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var t = null;
        try {
          t = localStorage.getItem('theme');
        } catch (e) {}
        root.classList.toggle('dark', t !== 'light');
      })();
    </script>
  </head>
  <body class="min-h-screen relative overflow-x-hidden flex flex-col">
    <a href="#contenu" class="sr-only sr-only-focusable fixed top-3 left-3 z-[100] bg-cyan-500 text-white px-4 py-2 rounded-lg font-bold">Aller au contenu</a>
    <MouseTrail />
    <Header />
    <slot name="fixed" />
    <main id="contenu" tabindex="-1" class="flex-1 page-enter">
      <slot />
    </main>
    <Footer />

    <script>
      // Sélecteur de thème
      const root = document.documentElement;
      document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
        const sync = () =>
          b.setAttribute('aria-label', root.classList.contains('dark') ? 'Passer en mode clair' : 'Passer en mode sombre');
        sync();
        b.addEventListener('click', () => {
          const dark = !root.classList.contains('dark');
          root.classList.toggle('dark', dark);
          try {
            localStorage.setItem('theme', dark ? 'dark' : 'light');
          } catch (e) {}
          document.querySelectorAll('[data-theme-toggle]').forEach((x) =>
            x.setAttribute('aria-label', dark ? 'Passer en mode clair' : 'Passer en mode sombre'),
          );
        });
      });

      // Apparition au défilement
      const items = document.querySelectorAll('[data-reveal]');
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.08 },
      );
      items.forEach((el) => io.observe(el));

      // Onglets des fiches détaillées
      document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((group) => {
        const tabs = [...group.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
        const select = (tab: HTMLButtonElement) => {
          tabs.forEach((t) => {
            const on = t === tab;
            t.setAttribute('aria-selected', String(on));
            t.tabIndex = on ? 0 : -1;
            t.classList.toggle('bg-cyan-500', on);
            t.classList.toggle('text-white', on);
            t.classList.toggle('bg-gray-100', !on);
            t.classList.toggle('dark:bg-[#2a2a2f]', !on);
            t.classList.toggle('text-gray-600', !on);
            t.classList.toggle('dark:text-gray-400', !on);
            document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
          });
        };
        tabs.forEach((t, i) => {
          t.addEventListener('click', () => select(t));
          t.addEventListener('keydown', (e) => {
            const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
            if (!d) return;
            const n = tabs[(i + d + tabs.length) % tabs.length];
            n.focus();
            select(n);
          });
        });
        if (tabs[0]) select(tabs[0]);
      });
    </script>
  </body>
</html>
