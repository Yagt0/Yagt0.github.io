---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Formation from '../components/home/Formation.astro';
import Timeline from '../components/home/Timeline.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/site';
---

<Base title="Parcours & Formation" description="Parcours d'Ewan Lefevre : Bac Pro SN RISC, BTS SIO SISR en alternance chez SERVAIR, stages et objectif de Master en cybersécurité.">
  <div class="pt-32 bg-background transition-colors duration-300">
    <div class="container mx-auto px-6">
      <PageHeader
        icon="graduation"
        title="Parcours & Formation"
        subtitle="Du câblage en baie à la sécurité des infrastructures : formations, stages et alternance, avec un objectif clair, le pentest."
      >
        <div class="flex flex-wrap justify-center gap-3 mt-8">
          <a href={profile.cv} download class="px-6 py-3 bg-gradient-to-r from-cyan-600 to-blue-600 text-white font-bold rounded-xl flex items-center gap-2 text-sm hover:shadow-[0_0_20px_rgba(6,182,212,0.3)] transition-all active:scale-95">
            <Icon name="download" class="w-4 h-4" /> Télécharger mon CV (PDF)
          </a>
          <div class="flex items-center gap-2 px-4 py-3 rounded-xl border border-gray-200 dark:border-white/10 bg-surface dark:bg-[#1a1a1f] text-sm text-gray-600 dark:text-gray-400">
            <Icon name="globe" class="w-4 h-4 text-cyan-500" /> Anglais B1 · Espagnol A2
          </div>
        </div>
      </PageHeader>
    </div>
  </div>
  <Formation />
  <Timeline />
</Base>
