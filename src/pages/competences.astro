---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import Stats from '../components/home/Stats.astro';

/*
  Deux niveaux, sans pourcentage :
  - applied   : mis en œuvre dans une réalisation ou un stage (avec la source) ;
  - practiced : pratiqué en formation, en lab ou sur des plateformes.
*/
const categories = [
  {
    icon: 'network', title: 'Réseaux', color: 'cyan',
    applied: [
      ['VLAN, VTP et trunk', 'Projet HSP', '/projets/hsp/'],
      ['Routage inter-VLAN', 'Projet HSP', '/projets/hsp/'],
      ['Filtrage par ACL', 'Projet HSP', '/projets/hsp/'],
      ["Plan d'adressage IP, sous-réseaux", 'Projet HSP', '/projets/hsp/'],
      ['Commutateurs Cisco', 'HSP · Stage 2023', '/parcours/'],
      ['Câblage RJ45 et brassage', 'Stage 2023', '/parcours/'],
    ],
    practiced: ['Cisco Packet Tracer', 'TCP/IP', 'CCNA 1 (ITN)'],
  },
  {
    icon: 'server', title: 'Systèmes', color: 'blue',
    applied: [
      ['Active Directory : comptes, groupes, droits', 'Stages Xefi', '/parcours/'],
      ['Postes Windows 10/11 : migration, support', 'Stages', '/parcours/'],
    ],
    practiced: ['Windows Server 2022', 'DNS', 'DHCP', 'GPO', 'Debian', 'Ubuntu', 'Kali Linux', 'Raspberry Pi 5'],
  },
  {
    icon: 'shield', title: 'Cybersécurité', color: 'red',
    applied: [
      ["Analyse d'une campagne de phishing", 'Mission SERVAIR', '/missions/analyse-phishing/'],
      ["Tests d'intrusion et audits (participation)", 'Stage SERVAIR', '/parcours/'],
      ['Pare-feu Sophos', 'Stage Xefi', '/parcours/'],
    ],
    practiced: ['Nmap', 'Wireshark', 'Burp Suite', 'Metasploit', 'Notions de pentest', 'IIS', 'AD CS'],
  },
  {
    icon: 'code', title: 'Scripting', color: 'green',
    applied: [
      ["Python : script d'analyse et pseudonymisation", 'Mission SERVAIR', '/missions/analyse-phishing/'],
      ['Python : application en ligne de commande', 'PassForge', '/projets/passforge/'],
    ],
    practiced: ['Bash', 'GitLab'],
  },
  {
    icon: 'layers', title: 'Virtualisation', color: 'purple',
    applied: [['Conteneurs avec Podman', 'Alternance', '/alternance/']],
    practiced: ['Hyper-V', 'Proxmox', 'VMware'],
  },
  {
    icon: 'users', title: 'Organisation & Support', color: 'amber',
    applied: [
      ["Coordination d'équipe (Team Leader)", 'Projet HSP', '/projets/hsp/'],
      ['Planification avec GanttProject', 'Projet HSP', '/projets/hsp/'],
      ['Support N1/N2 et suivi de tickets', 'Stages Xefi', '/parcours/'],
    ],
    practiced: ['Documentation technique'],
  },
] as const;

const tone = {
  cyan: 'text-cyan-600 dark:text-cyan-400 bg-cyan-500/10 border-cyan-500/20',
  blue: 'text-blue-600 dark:text-blue-400 bg-blue-500/10 border-blue-500/20',
  red: 'text-red-600 dark:text-red-400 bg-red-500/10 border-red-500/20',
  green: 'text-green-600 dark:text-green-400 bg-green-500/10 border-green-500/20',
  purple: 'text-purple-600 dark:text-purple-400 bg-purple-500/10 border-purple-500/20',
  amber: 'text-amber-600 dark:text-amber-400 bg-amber-500/10 border-amber-500/20',
};
---

<Base title="Compétences" description="Compétences d'Ewan Lefevre par catégorie : réseaux, systèmes, cybersécurité, scripting, virtualisation et organisation, en distinguant le mis en œuvre du pratiqué.">
  <div class="pt-32 pb-12 bg-background transition-colors duration-300">
    <div class="container mx-auto px-6">
      <PageHeader
        icon="award"
        title="Compétences"
        subtitle="Par domaine, sans pourcentage ni niveau inventé. « Mis en œuvre » renvoie à la réalisation qui le prouve ; « Pratiqué » couvre la formation, le lab et les plateformes."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 max-w-7xl mx-auto">
        {
          categories.map((c) => (
            <div data-reveal class="group bg-surface dark:bg-[#1a1a1f] p-6 rounded-2xl border border-gray-200 dark:border-white/5 hover:border-cyan-500/30 transition-all duration-300 shadow-sm dark:shadow-none flex flex-col">
              <div class="flex items-center gap-3 mb-6">
                <div class={`p-2.5 rounded-xl border group-hover:scale-110 transition-transform ${tone[c.color]}`}>
                  <Icon name={c.icon} class="w-6 h-6" />
                </div>
                <h2 class="text-lg font-bold text-gray-900 dark:text-white">{c.title}</h2>
              </div>
              <p class="text-[9px] text-gray-400 uppercase font-bold tracking-widest mb-3 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-cyan-500" /> Mis en œuvre
              </p>
              <ul class="space-y-2 mb-6">
                {c.applied.map(([name, from, href]) => (
                  <li class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 bg-gray-50 dark:bg-black/40 border border-gray-200 dark:border-white/5 rounded-lg px-3 py-2">
                    <span class="text-sm text-gray-700 dark:text-gray-300">{name}</span>
                    <a href={href} class="text-[10px] font-bold text-cyan-600 dark:text-cyan-400 hover:underline whitespace-nowrap">{from}</a>
                  </li>
                ))}
              </ul>
              <p class="text-[9px] text-gray-400 uppercase font-bold tracking-widest mb-3 flex items-center gap-2 mt-auto">
                <span class="w-2 h-2 rounded-full border border-gray-400" /> Pratiqué
              </p>
              <div class="flex flex-wrap gap-2">
                {c.practiced.map((p) => (
                  <span class="text-[10px] uppercase font-bold tracking-wider bg-gray-100 dark:bg-black text-gray-600 dark:text-gray-500 px-2 py-1 rounded border border-gray-200 dark:border-white/5">{p}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <Stats />
</Base>
