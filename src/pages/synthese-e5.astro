---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Badge from '../components/Badge.astro';
import Icon from '../components/Icon.astro';
import { links, profile } from '../data/site';

const rows = [
  { title: "Analyse d'une campagne de phishing", href: '/missions/analyse-phishing/', kind: 'alternance', frame: 'Alternance SERVAIR (2026-2027)', work: 'Travaux réalisés en alternance', state: 'fait', stateLabel: 'Script testé' },
  { title: 'HSP : réseau interne sécurisé', href: '/projets/hsp/', kind: 'scolaire', frame: 'BTS SIO SISR, projet de groupe', work: 'Collectif (4), Team Leader', state: 'en-cours', stateLabel: 'En cours' },
  { title: 'PassForge', href: '/projets/passforge/', kind: 'perso', frame: 'Projet personnel', work: 'Individuel', state: 'en-cours', stateLabel: 'En amélioration' },
] as const;
const card = 'bg-surface dark:bg-[#1a1a1f] p-6 rounded-2xl border border-gray-200 dark:border-white/5 shadow-sm dark:shadow-none';
---

<Base title="Synthèse E5" description="Épreuve E5 du BTS SIO SISR : réalisations présentées, emplacement du tableau de synthèse officiel et présentation du portfolio d'Ewan Lefevre.">
  <div class="min-h-screen pt-32 pb-24 bg-background transition-colors duration-300">
    <div class="container mx-auto px-6">
      <PageHeader icon="table" title="Synthèse E5" subtitle="Les réalisations présentées pour l'épreuve E5 du BTS SIO SISR, le tableau de synthèse officiel et la présentation de ce portfolio." />

      <section class="max-w-6xl mx-auto mb-20">
        <SectionTitle title="Réalisations présentées" icon="layers" />
        <div class="overflow-x-auto rounded-2xl border border-gray-200 dark:border-white/5 bg-surface dark:bg-[#1a1a1f] shadow-sm dark:shadow-none" data-reveal>
          <table class="w-full text-sm min-w-[720px]">
            <caption class="sr-only">Réalisations présentées pour l'épreuve E5</caption>
            <thead class="text-left text-[10px] uppercase tracking-wider text-gray-500 bg-gray-50 dark:bg-black/40">
              <tr><th scope="col" class="px-5 py-4">Réalisation</th><th scope="col" class="px-5 py-4">Type</th><th scope="col" class="px-5 py-4">Cadre</th><th scope="col" class="px-5 py-4">Travail</th><th scope="col" class="px-5 py-4">État</th></tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-white/5">
              {
                rows.map((r) => (
                  <tr class="text-gray-600 dark:text-gray-400">
                    <th scope="row" class="px-5 py-4 text-left font-bold text-gray-900 dark:text-white"><a href={r.href} class="hover:text-cyan-500 transition-colors">{r.title}</a></th>
                    <td class="px-5 py-4"><Badge kind={r.kind} /></td>
                    <td class="px-5 py-4">{r.frame}</td>
                    <td class="px-5 py-4">{r.work}</td>
                    <td class="px-5 py-4"><Badge kind={r.state} label={r.stateLabel} /></td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <section class="max-w-6xl mx-auto mb-20">
        <SectionTitle title="Tableau de synthèse" icon="fileText" />
        {
          links.e5Table ? (
            <div class={`${card} flex flex-col md:flex-row items-center justify-between gap-4`} data-reveal>
              <p class="text-gray-700 dark:text-gray-300">Le tableau de synthèse officiel est disponible au format PDF.</p>
              <a href={links.e5Table} download class="px-6 py-3 bg-gradient-to-r from-cyan-600 to-blue-600 text-white font-bold rounded-xl flex items-center gap-2 text-sm">
                <Icon name="download" class="w-4 h-4" /> Télécharger le tableau (PDF)
              </a>
            </div>
          ) : (
            <div data-reveal class="flex flex-col sm:flex-row gap-5 p-8 rounded-2xl border-2 border-dashed border-gray-300 dark:border-white/10 bg-surface/50 dark:bg-[#1a1a1f]/50">
              <div class="p-3 bg-cyan-500/10 rounded-xl border border-cyan-500/20 w-fit h-fit">
                <Icon name="fileText" class="w-7 h-7 text-cyan-500" />
              </div>
              <div>
                <p class="font-bold text-lg text-gray-900 dark:text-white mb-2">Emplacement réservé au tableau officiel</p>
                <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed mb-4">
                  Le tableau sera publié ici à partir du document officiel de l'épreuve E5. Aucun tableau n'est reproduit en attendant, pour ne pas présenter un document non officiel comme tel.
                </p>
                <Badge kind="prevu" label="À compléter" />
              </div>
            </div>
          )
        }
      </section>

      <section class="max-w-6xl mx-auto">
        <SectionTitle title="À propos du portfolio" icon="code" />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class={card} data-reveal>
            <Icon name="layers" class="w-7 h-7 text-cyan-500 mb-3" />
            <h3 class="font-bold text-gray-900 dark:text-white mb-3">Contenu</h3>
            <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
              <li class="flex gap-2"><span class="text-cyan-500">▹</span><a href="/parcours/" class="hover:text-cyan-500">Parcours & formation</a></li>
              <li class="flex gap-2"><span class="text-cyan-500">▹</span><a href="/alternance/" class="hover:text-cyan-500">Entreprise & mission</a></li>
              <li class="flex gap-2"><span class="text-cyan-500">▹</span><a href="/projets/" class="hover:text-cyan-500">Projets</a> & <a href="/competences/" class="hover:text-cyan-500">compétences</a></li>
              <li class="flex gap-2"><span class="text-cyan-500">▹</span><a href="/veille/" class="hover:text-cyan-500">Veille technologique</a></li>
              <li class="flex gap-2"><span class="text-cyan-500">▹</span><a href={profile.cv} download class="hover:text-cyan-500">CV (PDF)</a> & <a href="/contact/" class="hover:text-cyan-500">contact</a></li>
            </ul>
          </div>
          <div class={card} data-reveal>
            <Icon name="server" class="w-7 h-7 text-blue-500 mb-3" />
            <h3 class="font-bold text-gray-900 dark:text-white mb-3">Technique</h3>
            <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
              <li class="flex gap-2"><span class="text-blue-500">▹</span>Site statique Astro + Tailwind CSS</li>
              <li class="flex gap-2"><span class="text-blue-500">▹</span>Hébergé sur GitHub Pages, déployé par GitHub Actions</li>
              <li class="flex gap-2"><span class="text-blue-500">▹</span>Thèmes sombre et clair, responsive</li>
            </ul>
          </div>
          <div class={card} data-reveal>
            <Icon name="lock" class="w-7 h-7 text-green-500 mb-3" />
            <h3 class="font-bold text-gray-900 dark:text-white mb-3">Principes</h3>
            <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
              <li class="flex gap-2"><span class="text-green-500">▹</span>Aucun cookie, aucun traceur</li>
              <li class="flex gap-2"><span class="text-green-500">▹</span>Aucune donnée interne publiée</li>
              <li class="flex gap-2"><span class="text-green-500">▹</span>Réalisé et prévu toujours distingués</li>
            </ul>
          </div>
        </div>
      </section>
    </div>
  </div>
</Base>
