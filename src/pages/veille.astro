---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Badge from '../components/Badge.astro';
import Icon from '../components/Icon.astro';
import { sources, articles, type SourceId } from '../data/veille';

const sorted = [...articles].sort((a, b) => b.date.localeCompare(a.date));
const ids = Object.keys(sources) as SourceId[];
const count = (id: SourceId) => articles.filter((a) => a.source === id).length;
const read = articles.filter((a) => a.status === 'consulte').length;
---

<Base title="Veille Technologique" description="Veille technologique d'Ewan Lefevre sur la sécurité des infrastructures informatiques : vulnérabilités, menaces et moyens de protection. Sources : CERT-FR, The Hacker News, Krebs on Security, Dark Reading.">
  <div class="min-h-screen pt-32 pb-24 bg-background transition-colors duration-300">
    <div class="container mx-auto px-6">
      <PageHeader
        icon="rss"
        title="Veille Techno"
        subtitle="Sécurité des infrastructures informatiques : vulnérabilités, menaces et moyens de protection. Organisée avec Feedly."
        code="sources: CERT-FR · The Hacker News · Krebs on Security · Dark Reading"
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto mb-16">
        <div data-reveal class="bg-surface dark:bg-[#1a1a1f] p-6 rounded-2xl border border-gray-200 dark:border-white/5 shadow-sm dark:shadow-none">
          <Icon name="target" class="w-7 h-7 text-cyan-500 mb-3" />
          <h2 class="font-bold text-gray-900 dark:text-white mb-2">Le thème</h2>
          <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">Comment les infrastructures sont attaquées (serveurs exposés, accès distant, messagerie, Active Directory) et quelles protections les sources recommandent.</p>
        </div>
        <div data-reveal class="bg-surface dark:bg-[#1a1a1f] p-6 rounded-2xl border border-gray-200 dark:border-white/5 shadow-sm dark:shadow-none">
          <Icon name="rss" class="w-7 h-7 text-green-500 mb-3" />
          <h2 class="font-bold text-gray-900 dark:text-white mb-2">La méthode</h2>
          <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">J'organise ma veille avec <strong class="text-gray-900 dark:text-white">Feedly</strong>, qui rassemble au même endroit les publications de mes quatre sources.</p>
        </div>
        <div data-reveal class="bg-surface dark:bg-[#1a1a1f] p-6 rounded-2xl border border-gray-200 dark:border-white/5 shadow-sm dark:shadow-none">
          <Icon name="info" class="w-7 h-7 text-amber-500 mb-3" />
          <h2 class="font-bold text-gray-900 dark:text-white mb-3">Les statuts</h2>
          <ul class="space-y-2 text-xs text-gray-600 dark:text-gray-400">
            <li class="flex items-center gap-2"><Badge kind="propose" /> sélectionné et vérifié, lecture non attestée</li>
            <li class="flex items-center gap-2"><Badge kind="consulte" /> lecture confirmée ({read} à ce jour)</li>
          </ul>
        </div>
      </div>

      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 max-w-7xl mx-auto flex items-center gap-3">
        <span class="w-1 h-6 bg-cyan-500 rounded-full"></span>Mes sources
      </h2>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-7xl mx-auto mb-16">
        {
          ids.map((id) => {
            const s = sources[id];
            return (
              <a href={s.url} target="_blank" rel="noopener noreferrer" data-reveal class="group bg-surface dark:bg-[#1a1a1f] rounded-2xl border border-gray-200 dark:border-white/5 overflow-hidden hover:border-cyan-500/40 hover:-translate-y-1 transition-all duration-300 shadow-sm dark:shadow-none flex flex-col">
                <div class:list={['aspect-[2/1] overflow-hidden', s.fit === 'contain' ? 'bg-white' : 'bg-black']}>
                  <img src={s.logo} alt={`Logo ${s.name}`} loading="lazy" class:list={['w-full h-full transition-transform duration-700 group-hover:scale-105', s.fit === 'contain' ? 'object-contain p-4' : 'object-cover']} />
                </div>
                <div class="p-4 flex-1 flex flex-col gap-2">
                  <p class="font-bold text-gray-900 dark:text-white text-sm flex items-center gap-2">
                    {s.name}
                    <span class="text-[9px] px-1.5 py-0.5 rounded border border-gray-200 dark:border-white/10 text-gray-500">{s.lang}</span>
                  </p>
                  <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed hidden sm:block">{s.description}</p>
                  <p class="text-[10px] font-mono text-cyan-600 dark:text-cyan-400 mt-auto">{count(id)} article{count(id) > 1 ? 's' : ''}</p>
                </div>
              </a>
            );
          })
        }
      </div>

      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
            <span class="w-1 h-6 bg-blue-500 rounded-full"></span>Sélection d'articles
            <span class="text-sm font-normal text-gray-500">({articles.length})</span>
          </h2>
          <div class="bg-white/90 dark:bg-[#1a1a1f]/90 backdrop-blur-md p-1.5 rounded-2xl border border-gray-200 dark:border-white/10 shadow-xl flex flex-wrap gap-1" role="group" aria-label="Filtrer par source">
            <button type="button" data-filter="all" aria-pressed="true" class="px-3 py-2 rounded-xl text-xs font-bold transition-colors">Toutes</button>
            {ids.map((id) => <button type="button" data-filter={id} aria-pressed="false" class="px-3 py-2 rounded-xl text-xs font-bold transition-colors">{sources[id].name}</button>)}
          </div>
        </div>
        <p class="text-xs text-gray-500 font-mono mb-8">Titres, dates et liens vérifiés sur les pages d'origine le 4 octobre 2026.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" aria-live="polite">
          {sorted.map((a) => <ArticleCard a={a} />)}
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  [data-filter] {
    color: rgb(107 114 128);
  }
  [data-filter]:hover {
    color: rgb(6 182 212);
  }
  [data-filter][aria-pressed='true'] {
    background: rgb(6 182 212);
    color: #fff;
  }
</style>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('article[data-source]');
  btns.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter;
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      cards.forEach((c) => {
        c.hidden = f !== 'all' && c.dataset.source !== f;
        c.classList.add('is-visible');
      });
    }),
  );
</script>
