---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page introuvable" description="Cette page n'existe pas ou a été déplacée.">
  <div class="min-h-[80vh] pt-32 pb-24 flex items-center justify-center bg-background relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(rgba(6,182,212,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(6,182,212,0.03)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,#000_60%,transparent_100%)]" aria-hidden="true"></div>
    <div class="relative text-center px-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-500 text-xs font-bold mb-6 font-mono">
        <Icon name="alert" class="w-3.5 h-3.5" /> HTTP 404
      </div>
      <p class="text-7xl md:text-9xl font-bold tracking-tighter bg-gradient-to-r from-gray-900 via-cyan-700 to-cyan-500 dark:from-white dark:via-cyan-200 dark:to-cyan-400 bg-clip-text text-transparent mb-4" aria-hidden="true">404</p>
      <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-4">Page introuvable</h1>
      <p class="text-gray-600 dark:text-gray-400 max-w-md mx-auto mb-10">Cette page n'existe pas ou a été déplacée. Retour en terrain connu :</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/" class="px-6 py-3 bg-gradient-to-r from-cyan-600 to-blue-600 text-white font-bold rounded-xl flex items-center gap-2 text-sm hover:shadow-[0_0_20px_rgba(6,182,212,0.3)] transition-all"><Icon name="home" class="w-4 h-4" />Accueil</a>
        <a href="/projets/" class="px-6 py-3 rounded-xl border border-gray-200 dark:border-white/10 bg-surface dark:bg-[#1a1a1f] text-gray-700 dark:text-gray-300 text-sm font-medium hover:border-cyan-500/50 transition-all">Projets</a>
        <a href="/contact/" class="px-6 py-3 rounded-xl border border-gray-200 dark:border-white/10 bg-surface dark:bg-[#1a1a1f] text-gray-700 dark:text-gray-300 text-sm font-medium hover:border-cyan-500/50 transition-all">Contact</a>
      </div>
    </div>
  </div>
</Base>
