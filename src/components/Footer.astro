---
import Icon from './Icon.astro';
import { profile, links } from '../data/site';

const year = new Date().getFullYear();
const plan = [
  { href: '/parcours/', label: 'Parcours' },
  { href: '/alternance/', label: 'Alternance & Mission' },
  { href: '/projets/', label: 'Projets & Lab' },
  { href: '/competences/', label: 'Compétences' },
  { href: '/veille/', label: 'Veille Techno' },
  { href: '/synthese-e5/', label: 'Synthèse E5' },
];
---

<footer class="bg-surface dark:bg-[#0f0f13] border-t border-gray-200 dark:border-cyan-900/20 relative overflow-hidden transition-colors duration-300">
  <div class="absolute top-0 left-1/4 w-96 h-1 bg-gradient-to-r from-transparent via-cyan-500/50 to-transparent blur-sm"></div>
  <div class="container mx-auto px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <div class="col-span-1 md:col-span-2 space-y-4">
        <div class="flex items-center gap-2">
          <div class="p-2 bg-cyan-500/10 rounded-lg border border-cyan-500/20">
            <Icon name="terminal" class="w-6 h-6 text-cyan-600 dark:text-cyan-400" />
          </div>
          <span class="text-xl font-bold bg-gradient-to-r from-gray-900 to-gray-500 dark:from-white dark:to-gray-400 bg-clip-text text-transparent">Ewan Lefevre</span>
        </div>
        <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed max-w-sm">
          Étudiant en BTS SIO SISR et alternant en cybersécurité chez SERVAIR. Réseau, systèmes et sécurité offensive, en route vers le pentest.
        </p>
        <div class="flex items-center gap-2 text-xs text-gray-500 pt-2">
          <Icon name="zap" class="w-3 h-3" />
          <span>Propulsé par Astro • Tailwind • GitHub Pages</span>
        </div>
      </div>

      <div>
        <h3 class="font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
          <Icon name="gitBranch" class="w-4 h-4 text-cyan-500" />
          Plan du site
        </h3>
        <ul class="space-y-2 text-sm">
          {
            plan.map((p) => (
              <li>
                <a href={p.href} class="text-gray-600 dark:text-gray-400 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors flex items-center gap-2 group">
                  <span class="w-1 h-1 bg-cyan-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></span>
                  {p.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
          <Icon name="shield" class="w-4 h-4 text-blue-500" />
          Réseaux
        </h3>
        <div class="flex flex-col space-y-3">
          <a href={links.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-gray-600 dark:text-gray-400 hover:text-cyan-600 dark:hover:text-white transition-colors group">
            <Icon name="linkedin" class="w-5 h-5 text-blue-600 dark:text-blue-500 group-hover:scale-110 transition-transform" />
            <span class="text-sm">LinkedIn</span>
          </a>
          <a href={links.github} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-gray-600 dark:text-gray-400 hover:text-cyan-600 dark:hover:text-white transition-colors group">
            <Icon name="github" class="w-5 h-5 text-purple-600 dark:text-purple-500 group-hover:scale-110 transition-transform" />
            <span class="text-sm">GitHub</span>
          </a>
          <a href={links.rootme} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-gray-600 dark:text-gray-400 hover:text-cyan-600 dark:hover:text-white transition-colors group">
            <Icon name="trophy" class="w-5 h-5 text-[#e74c3c] group-hover:scale-110 transition-transform" />
            <span class="text-sm">Root-Me</span>
          </a>
          <a href={links.tryhackme} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-gray-600 dark:text-gray-400 hover:text-cyan-600 dark:hover:text-white transition-colors group">
            <Icon name="target" class="w-5 h-5 text-[#FF4141] group-hover:scale-110 transition-transform" />
            <span class="text-sm">TryHackMe</span>
          </a>
          <a href={`mailto:${profile.email}`} class="flex items-center gap-3 text-gray-600 dark:text-gray-400 hover:text-cyan-600 dark:hover:text-white transition-colors group">
            <Icon name="mail" class="w-5 h-5 text-red-600 dark:text-red-500 group-hover:scale-110 transition-transform" />
            <span class="text-sm">Email</span>
          </a>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-200 dark:border-white/5 pt-8 mt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex flex-col md:flex-row items-center gap-4 md:gap-8">
        <p class="text-xs text-gray-500">© {year} Ewan Lefevre. Tous droits réservés.</p>
        <a href="/mentions-legales/" class="text-xs text-gray-500 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors underline decoration-gray-500/30 underline-offset-4">Mentions Légales</a>
      </div>
      <div class="flex items-center gap-2 text-xs text-gray-500">
        <Icon name="activity" class="w-3 h-3" />
        <span class="font-mono">Site statique · sans cookie ni traceur</span>
      </div>
    </div>
  </div>
</footer>
