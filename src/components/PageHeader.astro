---
/* En-tête des pages listes, calqué sur la page « Lab & Projets » de la référence. */
import Icon from './Icon.astro';

interface Props {
  title: string;
  subtitle?: string;
  icon: string;
  code?: string;
}

const { title, subtitle, icon, code } = Astro.props;
---

<div class="flex flex-col items-center text-center mb-16">
  <div class="p-4 bg-surface dark:bg-[#1a1a1f] rounded-2xl border border-gray-200 dark:border-white/10 mb-6 shadow-xl dark:shadow-2xl">
    <Icon name={icon as 'home'} class="w-12 h-12 text-cyan-600 dark:text-cyan-500" />
  </div>
  <h1 class="text-4xl md:text-6xl font-bold text-gray-900 dark:text-white mb-6 tracking-tight">{title}</h1>
  {
    subtitle && (
      <p class="text-gray-600 dark:text-gray-400 max-w-2xl text-lg leading-relaxed">
        {subtitle}
        {code && <span class="text-sm font-mono text-cyan-600 dark:text-cyan-400 mt-3 block bg-gray-100 dark:bg-white/5 px-2 py-1 rounded w-fit mx-auto">{code}</span>}
      </p>
    )
  }
  <slot />
</div>
