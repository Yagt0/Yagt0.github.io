---
/* Carte projet, calquée sur les cartes « Lab & Projets » de la référence. */
import Icon from './Icon.astro';
import Badge from './Badge.astro';
import type { Realisation } from '../data/realisations';

interface Props {
  item: Realisation;
}
const { item } = Astro.props;
const kindLabel = { alternance: 'Mission pro', scolaire: 'Projet BTS', perso: 'Projet perso' };
---

<a
  href={item.href}
  data-reveal
  class="group relative bg-surface dark:bg-[#1a1a1f] rounded-2xl border border-gray-200 dark:border-white/5 overflow-hidden flex flex-col h-full hover:border-cyan-500/30 hover:-translate-y-2 hover:shadow-[0_0_30px_rgba(6,182,212,0.1)] transition-all duration-300 shadow-sm dark:shadow-none"
>
  <div class:list={['relative h-56 overflow-hidden border-b border-gray-100 dark:border-white/5', item.imageFit === 'contain' && 'bg-white']}>
    <div class="absolute inset-0 bg-cyan-900/20 group-hover:bg-transparent transition-colors z-10 duration-500"></div>
    <img
      src={item.image}
      alt=""
      loading="lazy"
      decoding="async"
      class:list={[
        'w-full h-full transition-transform duration-700 group-hover:scale-110',
        item.imageFit === 'contain' ? 'object-contain p-3' : 'object-cover object-left-top',
      ]}
    />
    <div class="absolute inset-0 bg-gradient-to-t from-surface dark:from-[#1a1a1f] via-surface/40 dark:via-[#1a1a1f]/40 to-transparent opacity-90 z-10"></div>
    <div class="absolute top-4 left-4 z-20">
      <span class="px-3 py-1 bg-black/60 backdrop-blur-md border border-white/10 rounded-lg text-xs font-bold text-white shadow-xl">{kindLabel[item.kind]}</span>
    </div>
  </div>

  <div class="p-6 pt-0 flex-1 flex flex-col relative z-20">
    <div class="-mt-8 mb-4">
      <div class="w-14 h-14 bg-surface dark:bg-[#1a1a1f] rounded-xl border border-gray-200 dark:border-white/10 p-1 flex items-center justify-center shadow-xl group-hover:border-cyan-500/50 transition-colors">
        <Icon name={item.icon} class="w-6 h-6 text-cyan-600 dark:text-cyan-400" />
      </div>
    </div>
    <h3 class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors mb-3">{item.title}</h3>
    <p class="text-gray-600 dark:text-gray-400 text-sm mb-6 leading-relaxed flex-grow">{item.summary}</p>
    <div class="flex flex-col gap-4 mt-auto">
      <div class="flex flex-wrap gap-2">
        {item.tags.map((t) => <span class="text-[10px] uppercase font-bold tracking-wider bg-cyan-500/5 text-cyan-700 dark:text-cyan-300 px-2 py-1 rounded border border-cyan-500/10">{t}</span>)}
      </div>
      <div class="flex items-center justify-between pt-4 border-t border-gray-100 dark:border-white/5 text-sm font-medium">
        <Badge kind={item.status} label={item.statusLabel} />
        <span class="flex items-center gap-2 text-gray-500 group-hover:text-cyan-500 transition-colors">
          Voir les détails
          <span class="w-8 h-8 rounded-full bg-gray-100 dark:bg-white/5 flex items-center justify-center text-gray-400 dark:text-white group-hover:bg-cyan-600 group-hover:text-white transition-colors">
            <Icon name="chevronRight" class="w-4 h-4" />
          </span>
        </span>
      </div>
    </div>
  </div>
</a>
