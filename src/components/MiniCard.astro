---
/* Petite carte grise (#2a2a2f) utilisée dans les blocs des fiches détaillées. */
import Icon from './Icon.astro';

interface Props {
  title: string;
  icon?: string;
}
const { title, icon } = Astro.props;
---

<div class="bg-gray-50 dark:bg-[#2a2a2f] p-4 rounded-lg border border-gray-200 dark:border-transparent">
  <div class="flex items-center gap-2 mb-3">
    {icon && <Icon name={icon as 'home'} class="w-5 h-5 text-cyan-600 dark:text-cyan-400 shrink-0" />}
    <h3 class="font-semibold text-gray-900 dark:text-white">{title}</h3>
  </div>
  <div class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed [&_ul]:space-y-2 [&_li]:flex [&_li]:gap-2">
    <slot />
  </div>
</div>
