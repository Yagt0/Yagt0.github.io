---
/* Cartes de stats des plateformes, au format de la référence. Chiffres réels (voir src/data/stats.ts). */
import Icon from '../Icon.astro';
import { tryhackme as thm, rootme, releve } from '../../data/stats';

const THM = '#FF4141';
const RM = '#e74c3c';
const CISCO = '#049fd9';
const LAB = '#22c55e';
const solvedPct = Math.round((rootme.solved / rootme.total) * 100);
const date = new Date(`${releve}T12:00:00`).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const rgba = (hex: string, a: number) => {
  const n = parseInt(hex.slice(1), 16);
  return `rgba(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}, ${a})`;
};
const card =
  'group relative bg-surface dark:bg-[#1a1a1f]/80 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-white/5 transition-all duration-300 flex flex-col overflow-hidden shadow-sm dark:shadow-none';
---

<section id="stats" class="py-12 bg-background transition-colors duration-300 scroll-mt-24">
  <div class="container mx-auto px-4 md:px-6">
    <h2 class="sr-only">Statistiques et pratique</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 max-w-7xl mx-auto">
      <!-- TryHackMe -->
      <div class={`${card} hover:border-[#FF4141]/40 hover:shadow-[0_0_30px_rgba(255,65,65,0.08)]`} data-reveal>
        <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" style={`background:${rgba(THM, 0.03)}`}></div>
        <div class="relative z-10 p-6 pb-4">
          <div class="flex items-start justify-between gap-3 mb-4">
            <div class="flex items-center gap-3">
              <div class="p-2.5 rounded-xl border group-hover:scale-110 transition-transform duration-300 shrink-0" style={`background:${rgba(THM, 0.1)};border-color:${rgba(THM, 0.2)}`}>
                <Icon name="target" class="w-6 h-6" style={`color:${THM}`} />
              </div>
              <div>
                <h3 class="text-base font-bold text-gray-900 dark:text-white leading-tight">TryHackMe</h3>
                <p class="font-mono text-xs" style={`color:${THM}`}>{thm.level}</p>
              </div>
            </div>
            <div class="shrink-0 text-right">
              <div class="text-2xl font-black text-gray-900 dark:text-white">{thm.rank}</div>
              <div class="text-[10px] text-gray-400 font-mono">global rank</div>
            </div>
          </div>
          <div class="grid grid-cols-3 gap-2">
            {
              [
                { label: 'Rooms', value: thm.rooms, icon: 'folder' },
                { label: 'Challenges', value: thm.challenges, icon: 'flag' },
                { label: 'Badges', value: thm.badges, icon: 'award' },
              ].map((s) => (
                <div class="rounded-xl border border-gray-100 dark:border-white/5 p-3 text-center group-hover:border-[#FF4141]/20 transition-colors" style={`background:${rgba(THM, 0.03)}`}>
                  <Icon name={s.icon as 'flag'} class="w-4 h-4 mx-auto mb-1.5" style={`color:${THM}`} />
                  <p class="text-[9px] text-gray-400 uppercase font-bold tracking-wider mb-0.5">{s.label}</p>
                  <p class="text-sm font-black text-gray-900 dark:text-white">{s.value}</p>
                </div>
              ))
            }
          </div>
        </div>
        <div class="relative z-10 px-6 py-3 border-t border-gray-100 dark:border-white/5">
          <p class="text-[9px] text-gray-400 uppercase font-bold tracking-widest mb-2">Apprentissage</p>
          <div class="flex flex-wrap gap-1.5">
            {thm.topics.map((t) => <span class="text-[9px] px-2 py-0.5 rounded-full font-medium border" style={`color:${THM};background:${rgba(THM, 0.08)};border-color:${rgba(THM, 0.2)}`}>{t}</span>)}
          </div>
        </div>
        <div class="relative z-10 mt-auto px-6 py-3 border-t border-gray-100 dark:border-white/5 flex items-center justify-end">
          <a href={thm.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-[10px] font-semibold hover:underline" style={`color:${THM}`}>
            tryhackme.com/p/{thm.handle} <Icon name="external" class="w-3 h-3" />
          </a>
        </div>
      </div>

      <!-- Root-Me -->
      <div class={`${card} hover:border-[#e74c3c]/40 hover:shadow-[0_0_30px_rgba(231,76,60,0.08)]`} data-reveal>
        <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" style={`background:${rgba(RM, 0.03)}`}></div>
        <div class="relative z-10 p-6 pb-4">
          <div class="flex items-start justify-between gap-3 mb-4">
            <div class="flex items-center gap-3">
              <div class="p-2.5 rounded-xl border group-hover:scale-110 transition-transform duration-300 shrink-0" style={`background:${rgba(RM, 0.1)};border-color:${rgba(RM, 0.2)}`}>
                <Icon name="trophy" class="w-6 h-6" style={`color:${RM}`} />
              </div>
              <div>
                <h3 class="text-base font-bold text-gray-900 dark:text-white leading-tight">Root-Me</h3>
                <p class="font-mono text-xs" style={`color:${RM}`}>Rang #{rootme.place.toLocaleString('fr-FR')}</p>
              </div>
            </div>
            <div class="shrink-0 text-right">
              <div class="text-2xl font-black text-gray-900 dark:text-white">{rootme.points}</div>
              <div class="text-[10px] text-gray-400 font-mono">points</div>
            </div>
          </div>
          <div class="w-full h-1.5 bg-gray-100 dark:bg-white/5 rounded-full overflow-hidden mb-1">
            <div class="h-full rounded-full" style={`width:${solvedPct}%;background:${RM}`}></div>
          </div>
          <div class="flex justify-between text-[10px] font-mono text-gray-400 mb-4">
            <span>{rootme.solved}/{rootme.total} challenges</span>
            <span>{solvedPct}%</span>
          </div>
          <div class="space-y-2 max-h-44 overflow-y-auto pr-1 custom-scrollbar">
            {
              rootme.categories.map((c) => (
                <div class="flex items-center gap-2">
                  <span class="text-[9px] font-bold uppercase tracking-wider w-24 shrink-0 text-gray-400 truncate">{c.name}</span>
                  <div class="flex-1 h-1 bg-gray-100 dark:bg-white/5 rounded-full overflow-hidden">
                    <div class="h-full rounded-full" style={`width:${c.pct}%;background:${RM}`}></div>
                  </div>
                  <span class="text-[10px] font-mono text-gray-400 w-8 text-right shrink-0">{c.pct}%</span>
                </div>
              ))
            }
          </div>
        </div>
        <div class="relative z-10 mt-auto px-6 py-3 border-t border-gray-100 dark:border-white/5 flex items-center justify-end">
          <a href={rootme.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-[10px] font-semibold hover:underline" style={`color:${RM}`}>
            root-me.org/{rootme.handle} <Icon name="external" class="w-3 h-3" />
          </a>
        </div>
      </div>

      <!-- Cisco NetAcad -->
      <div class={`${card} hover:border-[#049fd9]/40 hover:shadow-[0_0_30px_rgba(4,159,217,0.08)]`} data-reveal>
        <div class="relative z-10 p-6 pb-4">
          <div class="flex items-start justify-between gap-3 mb-4">
            <div class="flex items-center gap-3">
              <div class="p-2.5 rounded-xl border group-hover:scale-110 transition-transform duration-300 shrink-0" style={`background:${rgba(CISCO, 0.1)};border-color:${rgba(CISCO, 0.2)}`}>
                <Icon name="network" class="w-6 h-6" style={`color:${CISCO}`} />
              </div>
              <div>
                <h3 class="text-base font-bold text-gray-900 dark:text-white leading-tight">Cisco NetAcad</h3>
                <p class="font-mono text-xs" style={`color:${CISCO}`}>Cursus CCNA</p>
              </div>
            </div>
            <div class="shrink-0 text-right">
              <div class="text-2xl font-black text-gray-900 dark:text-white">1/3</div>
              <div class="text-[10px] text-gray-400 font-mono">modules</div>
            </div>
          </div>
          <div class="w-full h-1.5 bg-gray-100 dark:bg-white/5 rounded-full overflow-hidden mb-1">
            <div class="h-full rounded-full" style={`width:33%;background:${CISCO}`}></div>
          </div>
          <div class="flex justify-between text-[10px] font-mono text-gray-400 mb-4">
            <span>CCNA 1 validé</span>
            <span>33%</span>
          </div>
          <div class="space-y-2">
            {
              [
                { label: 'ITN', name: 'Introduction to Networks', done: true },
                { label: 'SRWE', name: 'Switching, Routing & Wireless', done: false },
                { label: 'ENSA', name: 'Enterprise Networking', done: false },
              ].map((m) => (
                <div class="flex items-center gap-2">
                  <span class="text-[9px] font-bold uppercase tracking-wider w-12 shrink-0 text-gray-400">{m.label}</span>
                  <span class="flex-1 text-[10px] text-gray-600 dark:text-gray-400 truncate">{m.name}</span>
                  <span class="text-[9px] font-bold uppercase" style={m.done ? `color:${CISCO}` : ''}>{m.done ? 'Validé' : '—'}</span>
                </div>
              ))
            }
          </div>
        </div>
        <div class="relative z-10 mt-auto px-6 py-3 border-t border-gray-100 dark:border-white/5">
          <p class="text-[10px] text-gray-400">Premier module validé : ce n'est pas la certification CCNA complète.</p>
        </div>
      </div>

      <!-- Lab perso -->
      <div class={`${card} hover:border-[#22c55e]/40 hover:shadow-[0_0_30px_rgba(34,197,94,0.08)]`} data-reveal>
        <div class="relative z-10 p-6 pb-4">
          <div class="flex items-start justify-between gap-3 mb-4">
            <div class="flex items-center gap-3">
              <div class="p-2.5 rounded-xl border group-hover:scale-110 transition-transform duration-300 shrink-0" style={`background:${rgba(LAB, 0.1)};border-color:${rgba(LAB, 0.2)}`}>
                <Icon name="cpu" class="w-6 h-6" style={`color:${LAB}`} />
              </div>
              <div>
                <h3 class="text-base font-bold text-gray-900 dark:text-white leading-tight">Lab perso</h3>
                <p class="font-mono text-xs" style={`color:${LAB}`}>Raspberry Pi 5</p>
              </div>
            </div>
            <div class="shrink-0 text-right">
              <div class="text-sm font-black text-gray-900 dark:text-white flex items-center gap-1.5 justify-end">
                <span class="w-2 h-2 rounded-full bg-green-500"></span>Actif
              </div>
              <div class="text-[10px] text-gray-400 font-mono">en continu</div>
            </div>
          </div>
          <ul class="space-y-2 text-xs text-gray-600 dark:text-gray-400">
            <li class="flex gap-2"><span style={`color:${LAB}`}>▹</span>Administration d'un serveur Linux à domicile</li>
            <li class="flex gap-2"><span style={`color:${LAB}`}>▹</span>Expérimentation réseau et services</li>
            <li class="flex gap-2"><span style={`color:${LAB}`}>▹</span>Configuration système</li>
          </ul>
        </div>
        <div class="relative z-10 mt-auto px-6 py-3 border-t border-gray-100 dark:border-white/5">
          <p class="text-[9px] text-gray-400 uppercase font-bold tracking-widest mb-2">Outils</p>
          <div class="flex flex-wrap gap-1.5">
            {['Linux', 'Kali', 'Nmap', 'Wireshark'].map((t) => <span class="text-[9px] px-2 py-0.5 rounded-full font-medium border" style={`color:${LAB};background:${rgba(LAB, 0.08)};border-color:${rgba(LAB, 0.2)}`}>{t}</span>)}
          </div>
        </div>
      </div>
    </div>
    <p class="text-center text-[10px] font-mono text-gray-400 mt-6">Statistiques relevées sur les profils publics le {date}.</p>
  </div>
</section>
