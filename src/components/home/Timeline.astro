---
/* « Trajectoire Professionnelle » : frise alternée gauche/droite, cartes teintées par couleur, comme la référence. */
import Icon from '../Icon.astro';

type Color = 'blue' | 'cyan' | 'green' | 'purple';
interface Step {
  date: string;
  title: string;
  subtitle: string;
  color: Color;
  icon: string;
  body: string;
  tags: string[];
  future?: boolean;
}

/* Les passages entre <b> sont mis en couleur. */
const steps: Step[] = [
  {
    date: '2023',
    title: 'Stage Infrastructure Réseau',
    subtitle: 'Dassault Falcon Service · Le Bourget',
    color: 'blue',
    icon: 'network',
    body: 'Premier contact avec le terrain : <b>câblage RJ45</b>, brassage en baie et <b>configuration de commutateurs Cisco</b>, en plus du support technique sur site.',
    tags: ['#Câblage', '#Cisco', '#Terrain'],
  },
  {
    date: '2023 - 2025',
    title: 'Stages Technicien Support IT',
    subtitle: 'Xefi Roissy · deux stages',
    color: 'blue',
    icon: 'wrench',
    body: 'Support utilisateurs <b>N1/N2</b>, gestion de tickets, administration <b>Active Directory</b> (comptes, groupes, droits) et configuration de <b>pare-feu Sophos</b>.',
    tags: ['#Support', '#ActiveDirectory', '#Sophos'],
  },
  {
    date: '2025',
    title: 'Bac Pro SN RISC',
    subtitle: 'Mention Bien',
    color: 'green',
    icon: 'graduation',
    body: 'Diplôme <b>Systèmes Numériques</b>, option <b>Réseaux Informatiques et Systèmes Communicants</b>, obtenu avec la mention Bien. Entrée en BTS SIO SISR.',
    tags: ['#Réseau', '#Diplôme'],
  },
  {
    date: 'Mai - Juin 2026',
    title: 'Stage Cybersécurité',
    subtitle: 'SERVAIR · Tremblay-en-France',
    color: 'cyan',
    icon: 'shield',
    body: "Premiers pas dans la cyber en entreprise : <b>tests d'intrusion</b> sur le périmètre interne, participation à des <b>audits de sécurité</b>, migration de postes et support.",
    tags: ['#Pentest', '#Audit'],
  },
  {
    date: '2026 - 2027',
    title: 'Alternance SERVAIR',
    subtitle: 'Cybersécurité · Siège',
    color: 'green',
    icon: 'briefcase',
    body: "Alternance au siège en parallèle de la 2<sup>e</sup> année de BTS. Mission d'<b>analyse d'une campagne de phishing</b> avec un <b>script Python</b> de pseudonymisation. Outils : GitLab, Podman, IIS, AD CS.",
    tags: ['#Phishing', '#Python', '#Alternance'],
  },
  {
    date: 'Après le BTS',
    title: "L'Horizon",
    subtitle: 'Objectif · pas une admission',
    color: 'purple',
    icon: 'target',
    body: "Poursuivre en cybersécurité jusqu'au <b>Master</b>, idéalement au <b>Luxembourg</b>, avec un cap clair : le <b>pentest</b> et la <b>Red Team</b>.",
    tags: ['#Master', '#RedTeam'],
    future: true,
  },
];

const tone: Record<Color, { card: string; dot: string; text: string; strong: string }> = {
  blue: {
    card: 'bg-blue-500/5 dark:bg-blue-500/10 border-blue-200 dark:border-blue-500/20 group-hover:border-blue-400 dark:group-hover:border-blue-500/50',
    dot: 'bg-blue-500',
    text: 'text-blue-600 dark:text-blue-400',
    strong: '[&_b]:text-blue-600 dark:[&_b]:text-blue-400',
  },
  cyan: {
    card: 'bg-cyan-500/5 dark:bg-cyan-500/10 border-cyan-200 dark:border-cyan-500/20 group-hover:border-cyan-400 dark:group-hover:border-cyan-500/50',
    dot: 'bg-cyan-500',
    text: 'text-cyan-600 dark:text-cyan-400',
    strong: '[&_b]:text-cyan-600 dark:[&_b]:text-cyan-400',
  },
  green: {
    card: 'bg-green-500/5 dark:bg-green-500/10 border-green-200 dark:border-green-500/20 group-hover:border-green-400 dark:group-hover:border-green-500/50',
    dot: 'bg-green-500',
    text: 'text-green-600 dark:text-green-400',
    strong: '[&_b]:text-green-600 dark:[&_b]:text-green-400',
  },
  purple: {
    card: 'bg-purple-500/5 dark:bg-purple-500/10 border-purple-200 dark:border-purple-500/20 group-hover:border-purple-400 dark:group-hover:border-purple-500/50',
    dot: 'bg-purple-500 motion-safe:animate-pulse shadow-[0_0_10px_#a855f7]',
    text: 'text-purple-600 dark:text-purple-400',
    strong: '[&_b]:text-purple-600 dark:[&_b]:text-purple-400',
  },
};
---

<section id="parcours" class="py-24 bg-background transition-colors duration-300 relative overflow-hidden scroll-mt-16">
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-cyan-500/20 to-transparent"></div>
  <div class="container mx-auto px-6 relative z-10">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-gray-900 dark:text-white">
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-gray-900 to-gray-500 dark:from-white dark:to-gray-400">Trajectoire Professionnelle</span>
      </h2>
      <p class="text-gray-600 dark:text-gray-400 max-w-xl mx-auto">Du câblage en baie à la cybersécurité : un parcours construit sur le terrain, stage après stage.</p>
    </div>

    <div class="max-w-4xl mx-auto relative">
      <div class="absolute left-[19px] md:left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-blue-500/20 via-cyan-500/50 to-purple-500/20 md:-translate-x-1/2"></div>
      <ol class="space-y-12">
        {
          steps.map((s, i) => {
            const t = tone[s.color];
            return (
              <li class={`relative flex flex-col md:flex-row gap-8 ${i % 2 === 0 ? 'md:flex-row-reverse' : ''}`} data-reveal>
                <div class="absolute left-0 md:left-1/2 w-10 h-10 -translate-x-[1px] md:-translate-x-1/2 flex items-center justify-center rounded-full bg-surface dark:bg-[#0a0a0f] border-2 border-gray-200 dark:border-[#1a1a1f] z-10 shadow-lg dark:shadow-[0_0_15px_rgba(0,0,0,0.8)]">
                  <div class={`w-3 h-3 rounded-full ${t.dot}`} />
                </div>
                <div class="hidden md:block flex-1" />
                <div class="flex-1 pl-12 md:pl-0">
                  <div
                    class={`group relative p-6 rounded-2xl bg-surface dark:bg-[#1a1a1f] border transition-all duration-500 shadow-sm dark:shadow-none ${t.card} ${s.future ? 'backdrop-blur-sm border-dashed' : 'hover:-translate-y-1 hover:shadow-xl'}`}
                  >
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white dark:bg-black/40 border border-gray-200 dark:border-white/5 text-xs font-mono mb-4 text-gray-600 dark:text-gray-300 shadow-sm dark:shadow-none">
                      <Icon name="calendar" class="w-3 h-3" />
                      {s.date}
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-1 flex items-center gap-2">
                      {s.title}
                      {s.future && <Icon name="sparkles" class="w-4 h-4 text-purple-500 motion-safe:animate-pulse" />}
                    </h3>
                    <p class={`text-sm font-medium mb-3 opacity-90 ${t.text}`}>{s.subtitle}</p>
                    <p class={`text-gray-600 dark:text-gray-400 text-sm leading-relaxed mb-4 [&_b]:font-bold ${t.strong}`} set:html={s.body} />
                    <div class="flex flex-wrap gap-2">
                      {s.tags.map((tag) => (
                        <span class={`text-[10px] px-2 py-1 rounded border ${s.future ? 'bg-purple-500/5 text-purple-700 dark:text-purple-200 border-purple-200 dark:border-purple-500/30' : 'bg-gray-100 dark:bg-black/30 border-gray-200 dark:border-white/5 text-gray-600 dark:text-gray-400'}`}>
                          {tag}
                        </span>
                      ))}
                    </div>
                    <div class={`absolute right-4 top-4 w-24 h-24 pointer-events-none text-gray-900 dark:text-white ${s.future ? 'opacity-[0.03] blur-[2px]' : 'opacity-[0.03]'}`} aria-hidden="true">
                      <Icon name={s.icon as 'target'} class="w-24 h-24" />
                    </div>
                  </div>
                </div>
              </li>
            );
          })
        }
      </ol>
      <div class="flex justify-center mt-16" aria-hidden="true">
        <div class="p-4 rounded-full bg-gradient-to-b from-transparent to-purple-500/5 border border-purple-500/20 flex gap-1.5">
          <span class="w-1.5 h-1.5 bg-purple-500 rounded-full motion-safe:animate-bounce"></span>
          <span class="w-1.5 h-1.5 bg-purple-500 rounded-full motion-safe:animate-bounce [animation-delay:150ms]"></span>
          <span class="w-1.5 h-1.5 bg-purple-500 rounded-full motion-safe:animate-bounce [animation-delay:300ms]"></span>
        </div>
      </div>
    </div>
  </div>
</section>
