---
/* Section « Formation & Certifications », structure identique à la référence. */
import Icon from '../Icon.astro';
---

<section id="formation" class="py-24 bg-background transition-colors duration-300 scroll-mt-16">
  <div class="container mx-auto px-6">
    <div class="flex items-center justify-between mb-12 gap-4">
      <div class="flex items-center gap-3">
        <Icon name="award" class="w-8 h-8 text-cyan-600 dark:text-cyan-500 shrink-0" />
        <h2 class="text-3xl font-bold bg-gradient-to-r from-gray-900 to-gray-500 dark:from-white dark:to-gray-400 bg-clip-text text-transparent">Formation & Certifications</h2>
      </div>
      <a href="/parcours/" class="hidden md:flex items-center gap-2 px-4 py-2 bg-cyan-500/10 text-cyan-700 dark:text-cyan-300 rounded-lg hover:bg-cyan-500/20 transition-all duration-300 group border border-cyan-500/20">
        <span>Voir le parcours complet</span>
        <Icon name="shield" class="w-4 h-4 transform transition-transform group-hover:translate-x-1" />
      </a>
    </div>

    <div class="grid grid-cols-1 gap-10">
      <!-- BTS SIO -->
      <div class="bg-surface dark:bg-[#1a1a1f] p-1 rounded-xl group hover:shadow-[0_0_20px_rgba(59,130,246,0.1)] transition-all duration-300 shadow-sm dark:shadow-none border border-gray-200 dark:border-transparent" data-reveal>
        <div class="bg-surface dark:bg-[#1a1a1f] p-6 md:p-8 rounded-xl border border-gray-200 dark:border-blue-900/20 hover:border-blue-500/40 transition-all h-full">
          <div class="flex flex-col lg:flex-row gap-8">
            <div class="lg:w-1/4 flex flex-col items-center lg:items-start gap-4">
              <div class="p-4 bg-gray-50 dark:bg-white/5 rounded-xl border border-gray-200 dark:border-white/10">
                <div class="w-32 h-32 grid place-items-center text-center leading-none" aria-hidden="true">
                  <span class="text-4xl font-black tracking-tighter text-gray-900 dark:text-white">BTS<br /><span class="text-blue-500">SIO</span></span>
                </div>
              </div>
              <div class="flex flex-col items-center lg:items-start gap-2 w-full">
                <div class="inline-flex items-center gap-2 px-3 py-1 bg-blue-500/10 border border-blue-500/20 rounded-full text-blue-600 dark:text-blue-300 text-xs font-medium">
                  <Icon name="calendar" class="w-3 h-3" /> 2025 - 2027
                </div>
                <a href="/parcours/" class="w-full py-2 bg-gray-100 dark:bg-[#2a2a30] hover:bg-blue-600/20 hover:text-blue-500 dark:hover:text-blue-300 text-gray-600 dark:text-gray-400 rounded-lg text-sm font-medium transition-colors flex items-center justify-center gap-2">
                  <Icon name="book" class="w-4 h-4" /> Mon parcours
                </a>
              </div>
            </div>
            <div class="lg:w-3/4">
              <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">BTS SIO - Option SISR</h3>
              <p class="text-blue-600 dark:text-blue-400 font-medium mb-4">Solutions d'Infrastructure, Systèmes et Réseaux</p>
              <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed mb-6">
                Lycée & UFA Robert Schuman, Dugny. Deuxième année en 2026-2027, en alternance chez SERVAIR. Formation de niveau Bac+2 orientée administration et sécurisation des infrastructures.
              </p>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-3">
                  <h4 class="text-sm font-semibold text-gray-800 dark:text-gray-200 flex items-center gap-2 uppercase tracking-wide">
                    <Icon name="server" class="w-4 h-4 text-blue-500" /> Systèmes & Virtualisation
                  </h4>
                  <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
                    <li class="flex gap-2"><span class="text-blue-500">▹</span>Windows Server (AD DS, DNS, DHCP, GPO)</li>
                    <li class="flex gap-2"><span class="text-blue-500">▹</span>Linux (Debian, Ubuntu, Kali)</li>
                    <li class="flex gap-2"><span class="text-blue-500">▹</span>Hyperviseurs (Hyper-V, Proxmox, VMware)</li>
                  </ul>
                </div>
                <div class="space-y-3">
                  <h4 class="text-sm font-semibold text-gray-800 dark:text-gray-200 flex items-center gap-2 uppercase tracking-wide">
                    <Icon name="network" class="w-4 h-4 text-blue-500" /> Réseau & Sécurité
                  </h4>
                  <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
                    <li class="flex gap-2"><span class="text-blue-500">▹</span>Architecture LAN (VLAN, VTP, trunk)</li>
                    <li class="flex gap-2"><span class="text-blue-500">▹</span>Routage inter-VLAN & filtrage ACL</li>
                    <li class="flex gap-2"><span class="text-blue-500">▹</span>Gestion de projet (GanttProject)</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- CCNA 1 -->
      <div class="relative group" data-reveal>
        <div class="absolute -inset-1 bg-gradient-to-r from-cyan-600 to-blue-600 rounded-2xl opacity-20 blur transition duration-500 group-hover:opacity-50"></div>
        <div class="relative bg-surface dark:bg-[#1a1a1f] p-6 md:p-8 rounded-xl border border-gray-200 dark:border-cyan-500/30 h-full shadow-sm dark:shadow-none">
          <div class="flex flex-col lg:flex-row gap-8">
            <div class="lg:w-1/4 flex flex-col items-center gap-6 border-b lg:border-b-0 lg:border-r border-gray-200 dark:border-cyan-500/20 pb-6 lg:pb-0 lg:pr-6">
              <div class="w-40 h-40 grid place-items-center rounded-full bg-cyan-500/5 border border-cyan-500/20 drop-shadow-xl" aria-hidden="true">
                <Icon name="network" class="w-20 h-20 text-cyan-500" />
              </div>
              <div class="w-full space-y-3">
                {
                  [
                    ['Organisme', 'Cisco NetAcad'],
                    ['Module', 'ITN (1 / 3)'],
                    ['Statut', 'Validé'],
                  ].map(([k, v]) => (
                    <div class="flex items-center justify-between text-sm bg-gray-50 dark:bg-[#0f0f13] p-3 rounded-lg border border-gray-200 dark:border-white/5">
                      <span class="text-gray-500 dark:text-gray-400">{k}</span>
                      <span class="text-cyan-700 dark:text-cyan-300 font-mono font-bold">{v}</span>
                    </div>
                  ))
                }
              </div>
            </div>
            <div class="lg:w-3/4 pl-0 lg:pl-4">
              <div class="flex justify-between items-start mb-4 gap-4">
                <div>
                  <h3 class="text-3xl font-bold text-gray-900 dark:text-white">CCNA 1</h3>
                  <p class="text-cyan-700 dark:text-cyan-400 text-lg">Introduction to Networks</p>
                </div>
                <a href="/competences/" class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-lg text-sm font-semibold transition-colors flex items-center gap-2 shadow-lg shadow-cyan-500/20 shrink-0">
                  <span>Compétences</span><Icon name="target" class="w-4 h-4" />
                </a>
              </div>
              <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-8 border-l-4 border-cyan-500 pl-4 bg-cyan-50 dark:bg-cyan-500/5 py-2">
                Premier module du cursus CCNA de la Cisco Networking Academy, <strong>validé</strong>. Ce n'est pas la certification CCNA complète.
              </p>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {
                  [
                    { icon: 'layers', title: 'Modèles & protocoles', items: ['Modèles OSI et TCP/IP', 'Ethernet et couche physique', 'Transport et application'] },
                    { icon: 'network', title: 'Adressage', items: ['IPv4 et sous-réseaux', 'IPv6', 'ARP et ICMP'] },
                    { icon: 'wrench', title: 'Configuration', items: ['Config de base switch', 'Config de base routeur', 'Bases de la sécurité réseau'] },
                  ].map((col) => (
                    <div class="space-y-2">
                      <h4 class="text-gray-900 dark:text-white font-semibold flex items-center gap-2 text-sm border-b border-gray-200 dark:border-white/10 pb-2">
                        <Icon name={col.icon as 'layers'} class="w-4 h-4 text-cyan-500" />
                        {col.title}
                      </h4>
                      <ul class="text-xs text-gray-600 dark:text-gray-400 space-y-1.5">
                        {col.items.map((i) => <li>• {i}</li>)}
                      </ul>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Bac Pro -->
      <div class="bg-surface dark:bg-[#1a1a1f] p-6 md:p-8 rounded-xl border border-gray-200 dark:border-green-900/20 hover:border-green-500/40 transition-all shadow-sm dark:shadow-none" data-reveal>
        <div class="flex flex-col md:flex-row md:items-center gap-6">
          <div class="p-4 bg-gray-50 dark:bg-white/5 rounded-xl border border-gray-200 dark:border-white/10 w-fit">
            <Icon name="graduation" class="w-10 h-10 text-green-500" />
          </div>
          <div class="flex-1">
            <div class="flex flex-wrap items-center gap-3 mb-1">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white">Bac Pro SN - Option RISC</h3>
              <span class="inline-flex items-center gap-2 px-3 py-1 bg-green-500/10 border border-green-500/20 rounded-full text-green-700 dark:text-green-300 text-xs font-medium">2025 · Mention Bien</span>
            </div>
            <p class="text-green-600 dark:text-green-400 font-medium text-sm">Systèmes Numériques, Réseaux Informatiques et Systèmes Communicants</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
