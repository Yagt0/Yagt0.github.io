---
/*
  Traînée de particules qui suit la souris (l'« étoile filante » de la référence), en tons cyan et bleu.
  Désactivée sur écran tactile et si l'utilisateur préfère réduire les animations.
*/
---

<canvas data-trail class="fixed inset-0 pointer-events-none z-[9999]" style="opacity:0.8" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-trail]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(pointer: fine)').matches;

  if (canvas && !reduce && fine) {
    const ctx = canvas.getContext('2d', { alpha: true })!;
    type P = { x: number; y: number; vx: number; vy: number; size: number; life: number; max: number; key: string };
    const parts: P[] = [];
    let raf: number | null = null;
    let last = { x: window.innerWidth / 2, y: window.innerHeight / 2 };

    const sprite = (rgb: string, s: number) => {
      const c = document.createElement('canvas');
      c.width = c.height = s;
      const g = c.getContext('2d')!;
      const h = s / 2;
      const grad = g.createRadialGradient(h, h, 0, h, h, h);
      grad.addColorStop(0, 'rgba(255, 255, 255, 1)');
      grad.addColorStop(0.2, `rgba(${rgb}, 0.8)`);
      grad.addColorStop(0.6, `rgba(${rgb}, 0.1)`);
      grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
      g.fillStyle = grad;
      g.fillRect(0, 0, s, s);
      return c;
    };
    const sprites: Record<string, HTMLCanvasElement> = {
      cyan: sprite('6, 182, 212', 64),
      blue: sprite('59, 130, 246', 64),
      sky: sprite('125, 211, 252', 64),
    };

    const resize = () => {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    };
    resize();
    window.addEventListener('resize', resize);

    const frame = () => {
      if (!parts.length) {
        if (raf) cancelAnimationFrame(raf);
        raf = null;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        return;
      }
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.globalCompositeOperation = 'lighter';
      for (let i = parts.length - 1; i >= 0; i--) {
        const p = parts[i];
        p.life--;
        p.x += p.vx;
        p.y += p.vy;
        p.size *= 0.96;
        if (p.life <= 0 || p.size < 0.5) {
          parts.splice(i, 1);
          continue;
        }
        ctx.globalAlpha = p.life / p.max;
        const d = p.size * 4;
        ctx.drawImage(sprites[p.key], p.x - d / 2, p.y - d / 2, d, d);
      }
      raf = requestAnimationFrame(frame);
    };

    window.addEventListener('mousemove', (e) => {
      const dx = e.clientX - last.x;
      const dy = e.clientY - last.y;
      const dist = Math.hypot(dx, dy);
      if (dist <= 5) return;
      const n = Math.min(Math.floor(dist / 5), 10);
      for (let i = 0; i < n; i++) {
        const t = i / n;
        const r = Math.random();
        parts.push({
          x: last.x + dx * t,
          y: last.y + dy * t,
          vx: (Math.random() - 0.5) * 0.5,
          vy: (Math.random() - 0.5) * 0.5,
          size: Math.random() * 4 + 2,
          life: 40,
          max: 40,
          key: r > 0.9 ? 'sky' : r > 0.6 ? 'blue' : 'cyan',
        });
      }
      last = { x: e.clientX, y: e.clientY };
      if (!raf) frame();
    });
  } else if (canvas) {
    canvas.remove();
  }
</script>
