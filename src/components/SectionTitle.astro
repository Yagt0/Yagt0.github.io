---
/* Titre de section façon référence : pastille icône + titre en dégradé gris, aligné à gauche ou centré. */
import Icon from './Icon.astro';

interface Props {
  title: string;
  icon?: string;
  subtitle?: string;
  center?: boolean;
  as?: 'h1' | 'h2';
}

const { title, icon, subtitle, center = false, as: Tag = 'h2' } = Astro.props;
---

<div class:list={['flex flex-col md:flex-row items-center justify-between mb-12 md:mb-16 gap-6', center && 'md:flex-col md:justify-center']}>
  <div class:list={['text-center', !center && 'md:text-left']}>
    <Tag class:list={['text-3xl md:text-4xl font-bold flex items-center gap-3 mb-2', center ? 'justify-center' : 'justify-center md:justify-start']}>
      {
        icon && (
          <div class="p-2 bg-cyan-500/10 rounded-lg border border-cyan-500/20 shrink-0">
            <Icon name={icon as 'home'} class="w-7 h-7 md:w-8 md:h-8 text-cyan-600 dark:text-cyan-400" />
          </div>
        )
      }
      <span class="bg-gradient-to-r from-gray-900 to-gray-500 dark:from-white dark:to-gray-400 bg-clip-text text-transparent">{title}</span>
    </Tag>
    {subtitle && <p class:list={['text-gray-600 dark:text-gray-400 max-w-xl mt-4', center && 'mx-auto']}>{subtitle}</p>}
  </div>
  <slot />
</div>
